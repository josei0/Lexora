# Postgres
POSTGRES_USER=applaw
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=applaw

# Backend
PORT=8080
DATABASE_URL=postgres://applaw:change_me_locally@localhost:5432/applaw?sslmode=disable
QDRANT_URL=http://localhost:6333

# Auth
JWT_SECRET=dev_secret_change_me
# WAJIB (backend gagal start kalau kosong) — kunci token admin, TERPISAH dari JWT_SECRET.
JWT_ADMIN_SECRET=dev_admin_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# WAJIB true di prod HTTPS: cookie pakai prefix __Host- yang menolak non-Secure.
COOKIE_SECURE=false

# CORS origin first-party (CSV). Prod WAJIB isi origin asli, bukan localhost.
# APP wajib muat landing + app (dua origin) — kalau tidak, /register & /login ditolak browser.
CORS_ORIGINS_APP=http://localhost:3000
CORS_ORIGINS_ADMIN=https://admin.lvh.me

# AI — chat lewat Maia Router (pakai MAIA_API_KEY + EMBEDDING_URL di bawah)
# tier AI: High (Pro) & Normal (Demo + degrade). Nilai HARUS sama dgn plans.model di DB (lihat db/seed).
# prefix beda disengaja: maia/* lewat Vertex (Haiku 404 di sana), anthropic/* jalur langsung.
CHAT_MODEL_HIGH=maia/claude-sonnet-4-5
CHAT_MODEL_NORMAL=anthropic/claude-haiku-4-5

# web search: model server-side (provider yang fetch) + allowlist domain.
# Allowlist dipakai dua kali: filter hasil search DAN SSRF guard saat ingest.
WEB_SEARCH_MODEL=openai/gpt-4o-mini-search-preview
WEB_SEARCH_DOMAINS=peraturan.bpk.go.id,peraturan.go.id,jdihn.go.id,putusan3.mahkamahagung.go.id

# RAG relevansi: skor cosine minimum (persen) sebelum chunk dipakai
RAG_MIN_SCORE_PCT=35

# Embedding — CLOUD via Maia Router (OpenAI-compatible, bayar IDR/QRIS)
EMBEDDING_PROVIDER=maia
EMBEDDING_URL=https://api.maiarouter.ai/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIM=3072
MAIA_API_KEY=sk-...

# RAG tuning
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Storage
STORAGE_DIR=./storage

# Seed super admin
SUPERADMIN_EMAIL=superadmin@mindlaw.web.id
SUPERADMIN_PASSWORD=admin_change_me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Update 6 (semua OPSIONAL; kosong = fitur mati, sistem tetap jalan) ──

# Mailer (Gmail SMTP + App Password). Kosong = no-op: register langsung aktif tanpa verifikasi email.
SMTP_USER=
SMTP_APP_PASSWORD=
# Base URL app untuk link verifikasi email register
APP_BASE_URL=http://localhost:3000

# Login Google. Kosong = tombol Google disembunyikan / endpoint /auth/google tolak.
# DUA env, nilai SAMA: backend verifikasi aud, FE render tombol GIS.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Alert saldo Maia. Threshold 0 = ticker mati. Butuh SMTP_* di atas untuk kirim email.
MAIA_BALANCE_THRESHOLD=0
MAIA_TOPUP_TOTAL_USD=0

# Mayar (payment gateway, update7). API key kosong = mode manual (invoice pending tanpa
# checkout URL, mark-paid manual super_admin). Webhook Mayar TANPA signature -> diverifikasi
# via re-fetch ke API pakai key ini (tak ada token webhook terpisah).
# BASE_URL: https://api.mayar.id (prod) / https://api.mayar.club (sandbox).
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.id
MAYAR_SUCCESS_URL=https://app.mindlaw.web.id/app/billing?paid=1
